#include <Arduino.h>
#include <U8g2lib.h>
#include <bitset>
#include <atomic>
#include <STM32FreeRTOS.h>
#include <ES_CAN.h>

// Uncomment to build a test version that measures the execution time of scanKeysTask
// When enabled, other threads and ISRs are disabled and the task body is called
// directly from setup(). The timing is printed on the serial port for 32 iterations.
//#define TEST_SCANKEYS
//#define TEST_DISPLAYUPDATE

//-----------------------------------------------------------------------CONSTANSTS----------------------------------------------------------
const uint32_t interval = 40; //Display update interval
const uint32_t stepSizes [] = { 51076057,54113197,57330935,60740010,64351799,68178356,72232452,76527617,81078186,85899346,91007187,96418756};
// note names for display, index 0=C ... 11=B
const char *noteNames[12] = {"C","C#","D","D#","E","F","F#","G","G#","A","A#","B"};

//--------------------------------PIN DEFINITIONS-----------------------------

  //Row select and enable
  const int RA0_PIN = D3;
  const int RA1_PIN = D6;
  const int RA2_PIN = D12;
  const int REN_PIN = A5;

  //Matrix input and output
  const int C0_PIN = A2;
  const int C1_PIN = D9;
  const int C2_PIN = A6;
  const int C3_PIN = D1;
  const int OUT_PIN = D11;

  //Audio analogue out
  const int OUTL_PIN = A4;
  const int OUTR_PIN = A3;

  //Joystick analogue in
  const int JOYY_PIN = A0;
  const int JOYX_PIN = A1;

  //Output multiplexer bits
  const int KNOB_MODE = 2;
  const int DEN_BIT = 3;
  const int DRST_BIT = 4;
  const int HKOW_BIT = 5;
  const int HKOE_BIT = 6;

//-------------------GLOBAL VARIABLES ----------------------------

std::atomic<uint32_t> currentStepSize{0};    // updated by keyboard scan (atomic)
QueueHandle_t msgInQ;

struct {
std::bitset<32> inputs; 
uint8_t currentNote = 255; // index of currently active note (0..11) or 255 for none

SemaphoreHandle_t mutex;  
} sysState;


// audio phase accumulator (used in ISR or loop if you prefer)
volatile uint32_t phaseAcc = 0;
uint8_t RX_Message[8]={0};

//-----------------------------------------------------------------------FUNCTIONS----------------------------------------------------------
//-------------------KNOB CLASS DEFINITION------------------------

// Thread-safe Knob class for quadrature decoding
class Knob {
private:
    uint8_t prevAB;
    std::atomic<uint8_t> rotation{0};
    uint8_t minVal, maxVal;
    
public:
    Knob(uint8_t min = 0, uint8_t max = 8) : prevAB(0), minVal(min), maxVal(max) {}
    
    // Called from scanKeysTask (not ISR) to update rotation based on quadrature inputs
    // bitpos: the starting bit position of the A,B signals (A at bitpos, B at bitpos+1)
    void update(uint32_t inputs, uint8_t bitpos) {
        uint8_t newAB = (inputs >> bitpos) & 0x03;
        
        if ((prevAB == 0b00 && newAB == 0b01) || (prevAB == 0b01 && newAB == 0b11) ||
            (prevAB == 0b11 && newAB == 0b10) || (prevAB == 0b10 && newAB == 0b00)) {
            // Clockwise transitions
            uint8_t current = rotation.load();
            if (current < maxVal) rotation.store(current + 1);
        } else if ((prevAB == 0b00 && newAB == 0b10) || (prevAB == 0b10 && newAB == 0b11) ||
                   (prevAB == 0b11 && newAB == 0b01) || (prevAB == 0b01 && newAB == 0b00)) {
            // Counter-clockwise transitions
            uint8_t current = rotation.load();
            if (current > minVal) rotation.store(current - 1);
        }
        prevAB = newAB;
    }
    
    // Get current rotation value (interrupt-safe atomic load)
    uint8_t getValue() const {
        return rotation.load();
    }
    
    // Set min/max limits (called from non-ISR context only)
    void setLimits(uint8_t min, uint8_t max) {
        minVal = min;
        maxVal = max;
    }
};


// 4 Knob instances: knob[0] at bits 18-19, knob[1] at bits 16-17, knob[2] at bits 14-15, knob[3] at bits 12-13
Knob knobs[4] = {Knob(0, 8), Knob(0, 8), Knob(0, 8), Knob(0, 8)};




// timer for audio sampling (22 kHz)
HardwareTimer sampleTimer(TIM1);

//Display driver object
U8G2_SSD1305_128X32_ADAFRUIT_F_HW_I2C u8g2(U8G2_R0);

//-------------------READING MUX------------------------


//Function to set outputs using key matrix
void setOutMuxBit(const uint8_t bitIdx, const bool value) {
      digitalWrite(REN_PIN,LOW);
      digitalWrite(RA0_PIN, bitIdx & 0x01);
      digitalWrite(RA1_PIN, bitIdx & 0x02);
      digitalWrite(RA2_PIN, bitIdx & 0x04);
      digitalWrite(OUT_PIN,value);
      digitalWrite(REN_PIN,HIGH);
      delayMicroseconds(2);
      digitalWrite(REN_PIN,LOW);
}



//Function to read column data C0 C1 C2 C3
std::bitset<4> readCols(){

  std::bitset<4> result;
  

  // matrix inputs are active low: a pressed key pulls the column to
  // ground. invert the raw read so that a pressed key produces a 1 bit.
  result[0] = digitalRead(C0_PIN);
  result[1] = digitalRead(C1_PIN);  
  result[2] = digitalRead(C2_PIN);
  result[3] = digitalRead(C3_PIN);

  return result;

}

//Select row 
void setRow(uint8_t rowIdx){
digitalWrite(REN_PIN,LOW);

digitalWrite(RA0_PIN, rowIdx & 0x01);
digitalWrite(RA1_PIN, rowIdx & 0x02);
digitalWrite(RA2_PIN, rowIdx & 0x04);
digitalWrite(REN_PIN,HIGH);
}

//-------------------CAN------------------------

void CAN_RX_ISR (void) {
	uint8_t RX_Message_ISR[8];
	uint32_t ID;
	CAN_RX(ID, RX_Message_ISR);
	xQueueSendFromISR(msgInQ, RX_Message_ISR, NULL);
}
//------------------------------------------------------------TASKS ---------------------------------------------------------

//-------------------CAN------------------------
void decodeTask (void * pvParameters){
  while(1){
    xQueueReceive(msgInQ, RX_Message, portMAX_DELAY);
  }
}


//-------------------UPDATE KNOBS,KEYS,DISPLAY------------------------

//Interrupt service routine called at 22 kHz
void sampleISR() {
  // load atomically to avoid torn reads when main loop updates the value
  uint32_t step = currentStepSize.load();
  phaseAcc += step;
  // top 12 bits -> DAC value
  uint32_t Vout = phaseAcc >> 20;
  Vout = Vout >> (8 - knobs[3].getValue()); // apply coarse volume control from knob 3
  analogWrite(OUTR_PIN, Vout);
  analogWrite(OUTL_PIN, Vout);
}


void scanKeysTask(void * pvParameters) {
#ifndef TEST_SCANKEYS
  const TickType_t xFrequency = 50/portTICK_PERIOD_MS;
  TickType_t xLastWakeTime = xTaskGetTickCount();
  //CAN tx message 
  uint8_t TX_Message[8] = {0};
  while(1) {
    vTaskDelayUntil(&xLastWakeTime, xFrequency);
#endif

    // clear previous readings - matrix is re-scanned each tqime
    sysState.inputs.reset();

  for(uint8_t row = 0; row < 8; row++){
    setRow(row);
    delayMicroseconds(3); //Allow signals to stabilise
    xSemaphoreTake(sysState.mutex, portMAX_DELAY);
    sysState.inputs |= (std::bitset<32>(std::bitset<4>(readCols()).to_ulong()) << (row*4));
    xSemaphoreGive(sysState.mutex);
    }
  {
    //---------------------------------------------------------------KNOBS-----------------
    xSemaphoreTake(sysState.mutex, portMAX_DELAY);
    uint32_t inputsCopy = sysState.inputs.to_ulong();
    xSemaphoreGive(sysState.mutex);
    
    // Update all 4 knobs using the Knob class
    // Knob 3: bits 12-13, Knob 2: bits 14-15, Knob 1: bits 16-17, Knob 0: bits 18-19
    knobs[3].update(inputsCopy, 12);
    knobs[2].update(inputsCopy, 14);
    knobs[1].update(inputsCopy, 16);
    knobs[0].update(inputsCopy, 18);
    
    //---------------------------------------------------------------KEYS----------------------------------------------------------
    // Determine which note is active
    uint8_t note = 255;
    uint8_t octave = 4; // default octave

    // consider only the lowest 12 bits corresponding to the 12 keys
    xSemaphoreTake(sysState.mutex, portMAX_DELAY);
    uint32_t newKeys = (~sysState.inputs.to_ulong()) & 0xFFF;
    xSemaphoreGive(sysState.mutex);

    // --------------------CAN TX MESSAGE-----------------
    // Compare against previous iteration to detect state changes
    static uint32_t prevKeys = 0xFFF;
    uint32_t changed = newKeys ^ prevKeys;  // bits that changed this iteration


    for (uint8_t k = 0; k < 12; k++) {
      if (changed & (1u << k)) {
          // this key changed state
          bool pressed = (newKeys & (1u << k)); // active low: 0 means pressed
          TX_Message[0] = pressed ? 'P' : 'R';
          TX_Message[1] = 2;   // CHANGE OCTAVE HERE
          TX_Message[2] = k;   // note number 0-11
          CAN_TX(0x123, TX_Message);
          }
    }

    prevKeys = newKeys;
    // --------------------SOUND GENERATION-----------------
    
    // if exactly one bit is set, lookup the corresponding step size;
    // otherwise silence (zero). this prevents combinations from selecting
    // an undefined index in the stepSizes array.
    /*
    if (newKeys && (newKeys & (newKeys - 1)) == 0) {
        // single note pressed; find bit position (0..11)
        note = 0;
        while ((newKeys & 1u) == 0u) {
            newKeys >>= 1;
            note++;
        }
        currentStepSize.store(stepSizes[note]);
    } else {
        currentStepSize.store(0);
    }
    xSemaphoreTake(sysState.mutex, portMAX_DELAY);
    sysState.currentNote = note;              // update global for display/other tasks
    xSemaphoreGive(sysState.mutex);
    */

    // --------------------SOUND GENERATION USING CAN RX-----------------
    note = RX_Message[2];
    octave = RX_Message[1];
    int8_t octaveOffset = octave - 4;
    if(RX_Message[0]=='P' && note < 12){
        
      uint32_t step = (octaveOffset >= 0) ? (stepSizes[note] << octaveOffset) 
                                          : (stepSizes[note] >> -octaveOffset);
      currentStepSize.store(step);
    } else if (RX_Message[0]=='R' && note < 12){
        currentStepSize.store(0);
    }

  }

#ifdef TEST_SCANKEYS
    // simulate worst-case processing by iterating over all 12 keys
    for (uint8_t k = 0; k < 12; ++k) {
        volatile uint32_t dummy = stepSizes[k]; (void)dummy;
    }
#endif

#ifndef TEST_SCANKEYS
  }
#endif
}


void displayUpdateTask(void * pvParameters) {

  const TickType_t xFrequency = interval/portTICK_PERIOD_MS;
  TickType_t xLastWakeTime = xTaskGetTickCount();

  uint32_t ID;
  

  while(1) {

  vTaskDelayUntil(&xLastWakeTime, xFrequency);
 

  //Update display

  
  u8g2.clearBuffer();         // clear the internal memory
  u8g2.setFont(u8g2_font_ncenB08_tr); // choose a suitable font
  u8g2.drawStr(0,10,"ES Synth Starter");  
    // display the active note name (or '-' if none)
  u8g2.setCursor(0,20);
  xSemaphoreTake(sysState.mutex, portMAX_DELAY);
  uint8_t localnote = sysState.currentNote; // read global state atomically for consistent display
  xSemaphoreGive(sysState.mutex);
  
  if (localnote < 12) {
      u8g2.print(noteNames[localnote]);
  } else {
      u8g2.print("-");
  }

  //display all 4 knob positions as bars
  // Knob 3 (volume) at row 2, Knob 2 at row 3, Knob 1 at row 4, Knob 0 at row 5
  
  // Knob 0 bar (row 2, x=20, y=15)
  uint8_t knob0Val = knobs[0].getValue();
  u8g2.drawFrame(20, 15, 16, 5);
  u8g2.drawBox(20, 15, knob0Val * 2, 5);
  
  // Knob 1 bar (row 2, x=37, y=15)
  uint8_t knob1Val = knobs[1].getValue();
  u8g2.drawFrame(37, 15, 16, 5);
  u8g2.drawBox(37, 15, knob1Val * 2, 5);
  
  // Knob 2 bar (row 2, x=54, y=15)
  uint8_t knob2Val = knobs[2].getValue();
  u8g2.drawFrame(54, 15, 16, 5);
  u8g2.drawBox(54, 15, knob2Val * 2, 5);
  
  // Knob 3 bar (row 2, x=71, y=15)
  uint8_t knob3Val = knobs[3].getValue();
  u8g2.drawFrame(71, 15, 16, 5);
  u8g2.drawBox(71, 15, knob3Val * 2, 5);

  u8g2.setCursor(80,30);
  u8g2.print((char) RX_Message[0]);
  u8g2.print(RX_Message[1]);
  u8g2.print(RX_Message[2]);
  
  u8g2.sendBuffer();          // transfer internal memory to the display
    

  //Toggle LED
  digitalToggle(LED_BUILTIN);
  }

}


void setup() {
  // put your setup code here, to run once:
  //Set audio resolution early
  analogWriteResolution(12);
  //Set pin directions
  pinMode(RA0_PIN, OUTPUT);
  pinMode(RA1_PIN, OUTPUT);
  pinMode(RA2_PIN, OUTPUT);
  pinMode(REN_PIN, OUTPUT);
  pinMode(OUT_PIN, OUTPUT);
  pinMode(OUTL_PIN, OUTPUT);
  pinMode(OUTR_PIN, OUTPUT);
  pinMode(LED_BUILTIN, OUTPUT);

  pinMode(C0_PIN, INPUT);
  pinMode(C1_PIN, INPUT);
  pinMode(C2_PIN, INPUT);
  pinMode(C3_PIN, INPUT);
  pinMode(JOYX_PIN, INPUT);
  pinMode(JOYY_PIN, INPUT);

  // configure audio output: 12-bit DAC on STM32
  analogWriteResolution(12);
  pinMode(OUTR_PIN, OUTPUT);          // DAC output pin must be configured as analog in STM32

  //Initialise display
  setOutMuxBit(DRST_BIT, LOW);  //Assert display logic reset
  delayMicroseconds(2);
  setOutMuxBit(DRST_BIT, HIGH);  //Release display logic reset
  u8g2.begin();
  setOutMuxBit(DEN_BIT, HIGH);  //Enable display power supply
  setOutMuxBit(KNOB_MODE, HIGH);  //Read knobs through key matrix

  //Initialise UART
  Serial.begin(9600);
  Serial.println("Hello World");

  //Initialise CAN
  CAN_Init(true);
  setCANFilter(0x123,0x7ff);
  //Making queue for rx messages from CAN bus
  msgInQ = xQueueCreate(36,8);
  CAN_RegisterRX_ISR(CAN_RX_ISR);
  CAN_Start();
  
  

  // Initialize mutex for shared state
  sysState.mutex = xSemaphoreCreateMutex();
  
  // setup 22 kHz interrupt
#ifndef TEST_SCANKEYS
  sampleTimer.setOverflow(22000, HERTZ_FORMAT);
  sampleTimer.attachInterrupt(sampleISR);
  sampleTimer.resume();
#endif

  // Create the key-scan task BEFORE starting scheduler
#ifdef TEST_SCANKEYS
  // Measure execution time of scanKeysTask for 32 iterations
  Serial.println("\n=== Measuring scanKeysTask execution time ===");
  unsigned long startTime, endTime, maxTime = 0, minTime = ULONG_MAX, totalTime = 0;
  
  for (int i = 0; i < 32; i++) {
    startTime = micros();
    scanKeysTask(NULL);
    endTime = micros();
    unsigned long duration = endTime - startTime;
    totalTime += duration;
    if (duration > maxTime) maxTime = duration;
    if (duration < minTime) minTime = duration;
    
    Serial.print("Iteration ");
    Serial.print(i);
    Serial.print(": ");
    Serial.print(duration);
    Serial.println(" µs");
  }
  
  Serial.println("\n=== Results ===");
  Serial.print("Min: ");
  Serial.print(minTime);
  Serial.print(" µs, Max: ");
  Serial.print(maxTime);
  Serial.print(" µs, Avg: ");
  Serial.print(totalTime / 32);
  Serial.println(" µs");
  Serial.println("Test complete. Halting.");
  
  while(1);  // Stop after measurements
#else
  TaskHandle_t scanKeysHandle = NULL;
  xTaskCreate(
    scanKeysTask,		/* Function that implements the task */
    "scanKeys",		/* Text name for the task */
    64,      		/* Stack size in words, not bytes */
    NULL,			/* Parameter passed into the task */
    2,			/* Task priority */
    &scanKeysHandle );	/* Pointer to store the task handle */

  TaskHandle_t displayUpdateHandle = NULL;
  xTaskCreate(
    displayUpdateTask,		/* Function that implements the task */
    "displayUpdate",		/* Text name for the task */
    256,      		/* Stack size in words, not bytes */
    NULL,			/* Parameter passed into the task */
    1,			/* Task priority */
    &displayUpdateHandle );	/* Pointer to store the task handle */

  TaskHandle_t decodeHandle = NULL;
  xTaskCreate(
    decodeTask,		/* Function that implements the task */
    "decode",		/* Text name for the task */
    256,      		/* Stack size in words, not bytes */
    NULL,			/* Parameter passed into the task */
    3,			/* Task priority */
    &decodeHandle );	/* Pointer to store the task handle */


  vTaskStartScheduler();
#endif
}


void loop() {}